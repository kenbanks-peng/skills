<tml version="1" title="Dispatch status">
  <state>{"revision":0,"board":{"run":"No snapshot","observed_at":"unknown","tasks":[]}}</state>
  <col pad="1" gap="1">
    <heading>Dispatch: {state.board.run}</heading>
    <text role="dim">Updated {state.board.observed_at} · revision {state.revision}</text>
    <tabs>
      <tab id="overview" title="Overview">
        <table rows="state.board.tasks" select="none">
          <column field="task" title="Task"/>
          <column field="state" title="Worker"/>
          <column field="environment" title="Host"/>
          <column field="blockers" title="Blocker"/>
        </table>
      </tab>
      <tab id="work" title="Work">
        <scroll><col gap="1">
          <table rows="state.board.tasks" select="none">
            <column field="task" title="Task"/>
            <column field="attempt" title="Attempt"/>
            <column field="task_state" title="Outcome"/>
            <column field="dependencies" title="Depends on"/>
          </table>
          <table rows="state.board.tasks" select="none">
            <column field="task" title="Task"/>
            <column field="agent" title="Agent"/>
            <column field="queue" title="Next work"/>
          </table>
        </col></scroll>
      </tab>
      <tab id="delivery" title="Delivery">
        <scroll><col gap="1">
          <table rows="state.board.tasks" select="none">
            <column field="task" title="Task"/>
            <column field="review" title="Review"/>
            <column field="checks" title="Checks"/>
          </table>
          <table rows="state.board.tasks" select="none">
            <column field="task" title="Task"/>
            <column field="delivery" title="Delivery"/>
            <column field="cleanup" title="Resources"/>
          </table>
        </col></scroll>
      </tab>
      <tab id="resources" title="Resources">
        <scroll><col gap="1">
          <table rows="state.board.tasks" select="none">
            <column field="task" title="Task"/>
            <column field="session" title="Session address"/>
            <column field="pane" title="Pane ID"/>
          </table>
          <table rows="state.board.tasks" select="none">
            <column field="branch" title="Branch"/>
            <column field="worktree" title="Checkout"/>
          </table>
          <table rows="state.board.tasks" select="none">
            <column field="task" title="Task"/>
            <column field="source" title="State source"/>
            <column field="identity" title="Identity"/>
          </table>
          <table rows="state.board.tasks" select="none">
            <column field="evidence_age_ms" title="Age (ms)"/>
            <column field="completion_seq" title="Turns"/>
            <column field="subagents" title="Subagents"/>
          </table>
        </col></scroll>
      </tab>
    </tabs>
  </col>
</tml>
